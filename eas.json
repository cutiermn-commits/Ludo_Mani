{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SERVER_URL": "wss://ludo-mani.onrender.com",
        "EXPO_PUBLIC_WEB_URL": "https://cutiermn-commits.github.io/Ludo_Mani/play"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SERVER_URL": "wss://ludo-mani.onrender.com",
        "EXPO_PUBLIC_WEB_URL": "https://cutiermn-commits.github.io/Ludo_Mani/play"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID"
      }
    }
  }
}
